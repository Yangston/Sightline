---
import "@/styles/global.css";
import "@/styles/viewer.css";
import "@/styles/sightline.css";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const {
  title,
  description,
  image = "/media/projects/sightline.svg",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body class="sightline-body">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="sightline-nav">
      <a class="sightline-wordmark" href="/" aria-label="Sightline home">
        Sightline<span aria-hidden="true">.</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/" aria-current={currentPath === "/" ? "page" : undefined}
          >Collection</a
        >
        <a
          href="/methodology"
          aria-current={currentPath.startsWith("/methodology")
            ? "page"
            : undefined}>About</a
        >
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="sightline-footer">
      <p>Photography &amp; code by Stone Yang</p>
      <p>&copy; 2026 Sightline</p>
    </footer>
  </body>
</html>
