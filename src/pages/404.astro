---
import SightlineLayout from "@/layouts/SightlineLayout.astro";
---

<SightlineLayout
  title="Not found — Sightline"
  description="The requested Sightline record was not found."
>
  <div class="sightline-shell">
    <section class="sightline-page-head">
      <p class="sightline-kicker">404 / no solution</p><h1>
        That sightline is missing.
      </h1><p class="sightline-lede">
        The requested route is not part of the public evidence register.
      </p><div class="sightline-actions">
        <a class="sightline-button primary" href="/explore"
          >Return to the dataset</a
        >
      </div>
    </section>
  </div>
</SightlineLayout>
