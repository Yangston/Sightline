---
import SightlineLayout from "@/layouts/SightlineLayout.astro";
import CityMapExperience from "@/components/photography/CityMapExperience";
import { imagesForCity } from "@/lib/dataset";
import { getStartingPhoto, isCollectionCity } from "@/lib/collection";
import {
  cityScenes,
  deriveStaticMapViewport,
  getPublicMapPhotoSummariesForCity,
  getPublicMapPhotoSummariesForMethod,
} from "@/lib/photography-map";
import type {
  CitySceneConfig,
  PublicMapPhotoSummary,
} from "@/lib/photography-map/types";

export function getStaticPaths() {
  return cityScenes
    .filter((city) => isCollectionCity(city.id))
    .map((city) => ({
      params: { city: city.id },
      props: {
        city,
        media: imagesForCity(city.id),
        photos: getPublicMapPhotoSummariesForCity(city.id),
        imageOnlyPhotos:
          city.id === "san-francisco"
            ? getPublicMapPhotoSummariesForMethod(city.id, "image-only")
            : undefined,
      },
    }));
}

interface Props {
  city: CitySceneConfig;
  media: ReturnType<typeof imagesForCity>;
  photos: PublicMapPhotoSummary[];
  imageOnlyPhotos?: PublicMapPhotoSummary[];
}

const { city, media, photos, imageOnlyPhotos } = Astro.props;
const googleKey = import.meta.env.PUBLIC_GOOGLE_MAP_TILES_API_KEY;
const viewport = deriveStaticMapViewport(city.bounds);
const cover = getStartingPhoto(city.id, media);
---

<SightlineLayout
  title={`${city.name} — Sightline`}
  description={city.description}
  image={cover?.variants.at(-1)?.src}
>
  <div class="sightline-city">
    <nav class="sightline-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Places</a><span aria-hidden="true">/</span><span
        aria-current="page">{city.name}</span
      >
    </nav>
    <CityMapExperience
      client:load
      city={city}
      photos={photos}
      imageOnlyPhotos={imageOnlyPhotos}
      sceneUrl={`/explore/${city.id}/scene.json`}
      viewport={viewport}
      googleKey={googleKey}
    />
  </div>
</SightlineLayout>
