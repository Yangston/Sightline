---
import SightlineLayout from "@/layouts/SightlineLayout.astro";
import { cityDatasetSummaries } from "@/lib/dataset";
import { collectionCityIds } from "@/lib/collection";

const scenes = collectionCityIds.map((id) =>
  cityDatasetSummaries().find(({ city }) => city.id === id)!,
);
const cover = scenes[0]?.sample?.variants.at(-1)?.src;
---

<SightlineLayout
  title="Sightline — Photographs & places"
  description="Explore San Francisco and Toronto through photographs and 3D maps."
  image={cover}
>
  <div class="sightline-shell">
    <header class="collection-intro">
      <h1>A place.<br /><em>A point of view.</em></h1>
      <p>Explore a city in 3D.</p>
    </header>
    <section class="scene-grid" aria-label="Choose a city">
      {
        scenes.map(({ city, sample }, index) => {
          const preview =
            sample?.variants.find((v) => v.width >= 960) ??
            sample?.variants.at(-1);
          return (
            <a
              class="scene-card"
              href={`/explore/${city.id}?view=3d`}
              aria-label={`${city.name} — Open 3D view`}
            >
              {preview && sample && (
                <div class="scene-image">
                  <img
                    src={preview.src}
                    srcset={sample.variants
                      .map((v) => `${v.src} ${v.width}w`)
                      .join(", ")}
                    sizes="(min-width: 600px) 48vw, 92vw"
                    width={sample.width}
                    height={sample.height}
                    alt={sample.alt}
                    loading="eager"
                    fetchpriority={index === 0 ? "high" : "auto"}
                    decoding="async"
                  />
                </div>
              )}
              <div class="scene-card-title">
                <>
                  <h2>{city.name}</h2>
                  <span aria-hidden="true">↗</span>
                </>
              </div>
              <p>Open 3D view</p>
            </a>
          );
        })
      }
    </section>
  </div>
</SightlineLayout>
