---
import SightlineLayout from "@/layouts/SightlineLayout.astro";
import { cityScenes } from "@/lib/photography-map/cities";

const controls = [
  {
    key: "headingDeg",
    name: "Direction",
    min: 0,
    max: 359,
    step: 1,
    unit: "°",
  },
  { key: "pitchDeg", name: "Tilt", min: -89, max: 89, step: 0.5, unit: "°" },
  { key: "rollDeg", name: "Roll", min: -180, max: 180, step: 0.5, unit: "°" },
  {
    key: "horizontalFovDeg",
    name: "Field of view",
    min: 0.1,
    max: 179.9,
    step: 0.1,
    unit: "°",
  },
];
---

<SightlineLayout
  title="Try your photo — Sightline"
  description="Start with your own photograph. Read its location privately, prepare a camera draft, and explore its perspective in 3D."
>
  <div class="upload-page sightline-shell">
    <header class="upload-heading">
      <p class="sightline-kicker">Your perspective, in context</p>
      <h1>Start with a photograph.</h1>
      <p>
        Find its place. Rebuild its perspective. Your photo’s metadata prepares
        the scene; you bring the final alignment into focus.
      </p>
    </header>
    <photo-upload
      data-google-key={import.meta.env.PUBLIC_GOOGLE_MAP_TILES_API_KEY}
      data-ion-token={import.meta.env.PUBLIC_CESIUM_ION_TOKEN}
    >
      <script
        is:inline
        type="application/json"
        data-upload-cities
        set:html={JSON.stringify(cityScenes).replaceAll("<", "\\u003c")}
      />
      <div class="upload-intro-grid">
        <section
          class="upload-dropzone"
          data-upload-dropzone
          aria-labelledby="upload-step-one"
        >
          <span class="upload-step">01 / Choose</span>
          <svg
            width="46"
            height="46"
            viewBox="0 0 48 48"
            fill="none"
            aria-hidden="true"
            ><rect
              x="6"
              y="7"
              width="36"
              height="34"
              rx="4"
              stroke="currentColor"
              stroke-width="1.25"></rect><circle
              cx="17"
              cy="18"
              r="3"
              stroke="currentColor"
              stroke-width="1.25"></circle><path
              d="m7 34 10-9 8 7 7-15 10 17"
              stroke="currentColor"
              stroke-width="1.25"></path></svg
          >
          <h2 id="upload-step-one">A new point of view.</h2>
          <p>
            Drop a photograph here, or choose one from your device. Original
            files are most likely to include location.
          </p>
          <label for="upload-file">Choose a photograph</label>
          <input
            id="upload-file"
            type="file"
            accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
            aria-describedby="upload-file-help"
            disabled
          />
          <p class="upload-caption" id="upload-file-help">
            JPEG, PNG or WebP · up to 40 MB
          </p>
        </section>
        <aside class="upload-how" aria-label="How it works">
          <p class="upload-step">A small journey from image to space</p>
          <ol>
            <li>
              <span>1</span><div>
                <strong>Read the photograph</strong><p>
                  Location and lens metadata are read on your device.
                </p>
              </div>
            </li>
            <li>
              <span>2</span><div>
                <strong>Find the scene</strong><p>
                  GPS matches a featured city or prepares a custom location.
                </p>
              </div>
            </li>
            <li>
              <span>3</span><div>
                <strong>Explore the perspective</strong><p>
                  Open 3D, inspect the camera frustum, then adjust the photo
                  overlay.
                </p>
              </div>
            </li>
          </ol>
          <p class="upload-privacy">
            <span aria-hidden="true">↗</span> Your photograph stays in this tab. Nothing
            is uploaded or added to the public collection.
          </p>
        </aside>
      </div>
      <noscript
        ><p class="upload-message">
          Enable JavaScript to read a local photo and open its 3D scene. You can
          still <a href="/explore">browse the reviewed collection</a>.
        </p></noscript
      >
      <p
        class="upload-message"
        data-upload-status
        role="status"
        aria-live="polite"
      >
        Choose a photograph to begin.
      </p>

      <section
        class="upload-result"
        data-upload-result
        hidden
        aria-labelledby="upload-step-two"
      >
        <div class="upload-result-head">
          <div>
            <p class="upload-step">02 / Discover</p><h2 id="upload-step-two">
              Your scene, prepared.
            </h2>
          </div><button
            class="upload-text-button"
            type="button"
            data-upload-reset>Remove photo</button
          >
        </div>
        <div class="upload-result-grid">
          <figure class="upload-preview">
            <img data-upload-image alt="Your selected photograph" /><figcaption
              data-upload-filename
            >
            </figcaption>
          </figure>
          <div class="upload-metadata">
            <span class="upload-badge">Approximate · unreviewed</span>
            <h3 data-upload-city>Finding the location…</h3>
            <dl>
              <div>
                <dt>Location</dt><dd data-upload-gps>Reading metadata…</dd>
              </div>
              <div>
                <dt>Lens</dt><dd data-upload-lens>Reading metadata…</dd>
              </div>
              <div>
                <dt>Direction</dt><dd data-upload-direction>
                  Reading metadata…
                </dd>
              </div>
            </dl>
            <p class="upload-caption" data-upload-explanation></p>
            <a class="upload-collection-link" data-upload-collection hidden
              >Explore this city’s collection <span aria-hidden="true">↗</span
              ></a
            >
          </div>
        </div>
        <details class="upload-location-details" data-upload-location-details>
          <summary>Add or adjust the location</summary>
          <form class="upload-location-form" data-upload-manual>
            <label class="upload-city-field" for="upload-city-select"
              >City (optional)<select id="upload-city-select"
                ><option value="">Choose a featured city</option>{
                  cityScenes.map((city) => (
                    <option value={city.id}>{city.name}</option>
                  ))
                }</select
              ></label
            >
            <label for="upload-latitude"
              >Latitude<input
                id="upload-latitude"
                type="number"
                min="-90"
                max="90"
                step="any"
                required
                placeholder="43.653"
              /></label
            >
            <label for="upload-longitude"
              >Longitude<input
                id="upload-longitude"
                type="number"
                min="-180"
                max="180"
                step="any"
                required
                placeholder="−79.383"
              /></label
            >
            <label for="upload-altitude"
              >Camera height (m)<input
                id="upload-altitude"
                type="number"
                min="-500"
                max="20000"
                step="any"
                placeholder="Estimated if blank"
              /></label
            >
            <button class="upload-button" type="submit">Prepare scene</button>
            <p class="upload-caption">
              A city selection uses its centre as a starting point. Adjust the
              coordinates to your actual camera position. Height is an
              approximate elevation above sea level.
            </p>
          </form>
        </details>
        <div class="upload-launch">
          <div>
            <p class="upload-step">03 / Explore</p><p>
              Ready for a different perspective?
            </p><p class="upload-caption">
              3D map providers receive requests for this location when you open
              the preview. Your photo stays local.
            </p>
          </div><button
            class="upload-button upload-button-primary"
            type="button"
            data-upload-open
            disabled>Open 3D preview <span aria-hidden="true">↗</span></button
          >
        </div>
      </section>

      <section
        class="upload-viewer"
        data-upload-viewer
        hidden
        aria-labelledby="upload-viewer-title"
      >
        <div class="upload-result-head">
          <div>
            <p class="upload-step">The local workspace</p><h2
              id="upload-viewer-title"
            >
              Bring the view into alignment.
            </h2>
          </div><button
            class="upload-text-button"
            type="button"
            data-upload-close>Close 3D</button
          >
        </div>
        <div class="upload-viewer-toolbar">
          <button
            class="upload-button"
            type="button"
            data-upload-orbit
            aria-pressed="true">Orbit frustum</button
          ><button
            class="upload-button"
            type="button"
            data-upload-align
            aria-pressed="false">Match photo view</button
          ><span class="upload-badge">Approximate · unreviewed</span>
        </div>
        <div class="upload-stage">
          <div
            class="upload-canvas"
            data-upload-canvas
            aria-label="3D camera perspective preview"
          >
          </div><img
            class="upload-overlay"
            data-upload-overlay
            alt="Photograph overlay for alignment"
            hidden
          />
        </div>
        <p
          class="upload-caption"
          data-upload-viewer-status
          role="status"
          aria-live="polite"
        >
        </p>
        <div class="upload-controls">
          {
            controls.map((control) => (
              <label for={`upload-${control.key}`}>
                <>
                  <span>
                    {control.name}
                    <output data-upload-output={control.key}>
                      0{control.unit}
                    </output>
                  </span>
                  <input
                    id={`upload-${control.key}`}
                    data-upload-pose={control.key}
                    type="range"
                    min={control.min}
                    max={control.max}
                    step={control.step}
                    value="0"
                  />
                </>
              </label>
            ))
          }<label for="upload-opacity"
            ><span
              >Photo opacity<output data-upload-opacity-output>50%</output
              ></span
            ><input
              id="upload-opacity"
              type="range"
              min="0"
              max="100"
              step="1"
              value="50"
            /></label
          ><button
            class="upload-text-button"
            type="button"
            data-upload-pose-reset>Reset camera draft</button
          >
        </div>
        <p class="upload-caption">
          Direction, tilt and roll control the camera; field of view controls
          its lens. Use “Match photo view” to compare with the image. GPS height
          may use a different reference from the map; adjust camera height above
          if the view is below ground. These controls create an approximate
          draft, not a verified reconstruction.
        </p>
      </section>
    </photo-upload>
  </div>
</SightlineLayout>

<script>
  import "@/lib/photo-upload/experience";
</script>

<style>
  .upload-page {
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .upload-heading {
    max-width: 48rem;
    margin-bottom: 3rem;
  }
  .upload-heading h1 {
    font-size: clamp(2.65rem, 6.5vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 1.05;
    margin: 1rem 0 1.5rem;
  }
  .upload-heading > p:last-child {
    color: var(--sl-muted);
    line-height: 1.75;
    max-width: 39rem;
    font-size: 1.05rem;
  }
  photo-upload {
    display: block;
    min-width: 0;
    width: 100%;
    max-width: 100%;
  }
  [hidden] {
    display: none !important;
  }
  .upload-intro-grid,
  .upload-result-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 4rem);
  }
  .upload-intro-grid > *,
  .upload-result-grid > *,
  .upload-how li > div {
    min-width: 0;
  }
  .upload-dropzone {
    border: 1px dashed var(--sl-line);
    border-radius: 1rem;
    background: var(--sl-panel);
    padding: clamp(1.5rem, 4vw, 3rem);
    transition: border-color 0.2s;
  }
  .upload-dropzone[data-dragging] {
    border-color: var(--sl-signal);
  }
  .upload-step {
    display: block;
    font: 0.65rem/1.4 var(--font-code);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--sl-muted);
  }
  .upload-dropzone svg {
    margin-top: 2.2rem;
    color: var(--sl-signal);
  }
  .upload-dropzone h2 {
    font-size: 1.8rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    margin: 1rem 0 0.75rem;
  }
  .upload-dropzone > p {
    color: var(--sl-muted);
    line-height: 1.7;
    max-width: 26rem;
  }
  .upload-dropzone label {
    display: block;
    font-size: 0.8rem;
    margin: 1.5rem 0 0.6rem;
  }
  #upload-file {
    display: block;
    box-sizing: border-box;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    color: var(--sl-muted);
    font: 0.75rem var(--font-sans);
  }
  #upload-file::file-selector-button {
    font: inherit;
    background: var(--sl-signal);
    color: var(--sl-bg);
    padding: 0.8rem 1rem;
    border: 0;
    border-radius: 0.3rem;
    margin-right: 0.75rem;
    cursor: pointer;
  }
  .upload-caption {
    color: var(--sl-muted);
    font-size: 0.75rem;
    line-height: 1.7;
  }
  .upload-how {
    padding: 1.5rem 0;
    align-self: center;
  }
  .upload-how ol {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
    display: grid;
    gap: 1.7rem;
  }
  .upload-how li {
    display: flex;
    gap: 1.2rem;
  }
  .upload-how li > span {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border: 1px solid var(--sl-line);
    border-radius: 50%;
    font: 0.7rem var(--font-code);
  }
  .upload-how strong {
    font-size: 0.95rem;
    font-weight: 500;
  }
  .upload-how li p {
    font-size: 0.85rem;
    color: var(--sl-muted);
    line-height: 1.65;
    margin: 0.35rem 0 0;
  }
  .upload-privacy {
    border-top: 1px solid var(--sl-line);
    padding-top: 1.5rem;
    font-size: 0.8rem;
    line-height: 1.75;
    color: var(--sl-muted);
  }
  .upload-privacy span {
    color: var(--sl-signal);
    margin-right: 0.4rem;
  }
  .upload-message {
    font-size: 0.85rem;
    line-height: 1.7;
    padding-block: 1rem;
    color: var(--sl-muted);
  }
  .upload-message[data-error] {
    color: var(--sl-fail);
  }
  .upload-result,
  .upload-viewer {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--sl-line);
  }
  .upload-result-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .upload-result-head h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    margin: 0.5rem 0 0;
  }
  .upload-text-button {
    border: 0;
    background: transparent;
    padding: 0.7rem 0;
    color: var(--sl-muted);
    font-size: 0.75rem;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .upload-text-button:hover {
    color: var(--sl-ink);
  }
  .upload-preview {
    margin: 0;
    min-width: 0;
  }
  .upload-preview img {
    width: 100%;
    height: 23rem;
    object-fit: contain;
    background: var(--sl-panel);
    border-radius: 0.5rem;
  }
  .upload-preview figcaption {
    color: var(--sl-muted);
    font-size: 0.7rem;
    margin-top: 0.6rem;
    overflow-wrap: anywhere;
  }
  .upload-metadata {
    padding-top: 1rem;
  }
  .upload-badge {
    display: inline-flex;
    font: 0.62rem/1.5 var(--font-code);
    color: var(--sl-warn);
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--sl-line);
    border-radius: 4rem;
  }
  .upload-metadata h3 {
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    margin: 1rem 0 1.5rem;
  }
  .upload-metadata dl {
    display: grid;
    gap: 1rem;
  }
  .upload-metadata dl div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0.5rem;
    font-size: 0.82rem;
  }
  .upload-metadata dt {
    color: var(--sl-muted);
  }
  .upload-metadata dd {
    margin: 0;
  }
  .upload-collection-link {
    display: inline-block;
    color: var(--sl-signal);
    font-size: 0.8rem;
    margin-top: 1rem;
    text-underline-offset: 0.3em;
  }
  .upload-location-details {
    border-block: 1px solid var(--sl-line);
    margin-top: 2rem;
  }
  .upload-location-details summary {
    padding: 1rem 0;
    cursor: pointer;
    font-size: 0.8rem;
  }
  .upload-location-form {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding: 0 0 1rem;
  }
  .upload-location-form label {
    display: grid;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--sl-muted);
  }
  .upload-location-form input,
  .upload-location-form select {
    min-width: 0;
    width: 100%;
    border: 1px solid var(--sl-line);
    background: var(--sl-panel);
    color: var(--sl-ink);
    padding: 0.75rem;
    border-radius: 0.3rem;
    font: 0.8rem var(--font-sans);
  }
  .upload-city-field,
  .upload-location-form .upload-caption {
    grid-column: 1 / -1;
  }
  .upload-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    border: 1px solid var(--sl-line);
    background: var(--sl-panel);
    color: var(--sl-ink);
    padding: 0.85rem 1.1rem;
    border-radius: 0.3rem;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .upload-button:hover,
  .upload-button[aria-pressed="true"] {
    border-color: var(--sl-signal);
  }
  .upload-button:disabled {
    opacity: 0.45;
    cursor: wait;
  }
  .upload-button-primary {
    background: var(--sl-signal);
    color: var(--sl-bg);
    border-color: var(--sl-signal);
    flex-shrink: 0;
  }
  .upload-launch {
    display: flex;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 2rem;
  }
  .upload-launch > div > p:nth-child(2) {
    margin: 0.5rem 0;
    font-size: 1.15rem;
  }
  .upload-launch .upload-caption {
    max-width: 35rem;
    margin-bottom: 0;
  }
  .upload-viewer-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  .upload-viewer-toolbar .upload-badge {
    margin-left: auto;
  }
  .upload-stage {
    position: relative;
    height: clamp(24rem, 65vh, 40rem);
    background: var(--sl-panel);
    border: 1px solid var(--sl-line);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .upload-canvas {
    position: absolute;
    inset: 0;
  }
  .upload-canvas :global(.cesium-widget-credits) {
    z-index: 2;
    background: rgb(7 16 15 / 85%);
  }
  .upload-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.5;
    pointer-events: none;
  }
  .upload-controls {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem 2rem;
    margin-block: 1.5rem;
  }
  .upload-controls label {
    min-width: 0;
    font-size: 0.75rem;
    color: var(--sl-muted);
  }
  .upload-controls label > span {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .upload-controls output {
    color: var(--sl-ink);
    font: 0.7rem var(--font-code);
  }
  .upload-controls input {
    width: 100%;
    accent-color: var(--sl-signal);
    margin: 0.8rem 0 0;
    min-height: 1.4rem;
  }
  @media (max-width: 720px) {
    .upload-intro-grid,
    .upload-result-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .upload-how {
      padding-top: 0.5rem;
    }
    .upload-heading {
      margin-bottom: 2rem;
    }
    .upload-result-head {
      align-items: start;
    }
    .upload-launch {
      align-items: start;
      flex-direction: column;
      gap: 1.25rem;
    }
    .upload-location-form {
      grid-template-columns: 1fr 1fr;
    }
    .upload-controls {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .upload-preview img {
      height: 19rem;
    }
    .upload-viewer-toolbar .upload-badge {
      margin-left: 0;
    }
  }
  @media (max-width: 380px) {
    .upload-location-form {
      grid-template-columns: 1fr;
    }
    .upload-result-head {
      flex-direction: column;
    }
    .upload-stage {
      height: 25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .upload-dropzone {
      transition: none;
    }
  }
</style>
