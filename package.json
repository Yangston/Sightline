{
  "name": "sightline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run data:check && astro check && astro build && npm run check:artifacts",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --plugin=prettier-plugin-astro --write .",
    "format:check": "prettier --plugin=prettier-plugin-astro --check .",
    "test:unit": "vitest run",
    "test": "node scripts/run-playwright.mjs",
    "data:import": "node scripts/data/import-snapshot.mjs",
    "data:check": "node scripts/data/check-snapshot.mjs",
    "check:artifacts": "node scripts/check-artifact-boundaries.mjs",
    "sightline:setup": "node scripts/photography/calibrate-map.mjs --setup",
    "sightline:reconstruct": "node scripts/sightline-reconstruct.mjs",
    "sightline:locate": "node scripts/photography/locate-image-only.mjs",
    "sightline:verify": "node scripts/photography/verify-map.mjs",
    "release:check": "npm run format:check && npm run lint && npm run test:unit && npm run check && npm run build && npm test"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.3",
    "@fontsource-variable/fraunces": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.0.9",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.57.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "cesium": "^1.143.0",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
